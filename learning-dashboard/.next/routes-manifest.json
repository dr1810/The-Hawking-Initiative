{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/accessibility-profile",
      "regex": "^/accessibility\\-profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accessibility\\-profile(?:/)?$"
    },
    {
      "page": "/diagnostic-assessment",
      "regex": "^/diagnostic\\-assessment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/diagnostic\\-assessment(?:/)?$"
    },
    {
      "page": "/learning-analytics",
      "regex": "^/learning\\-analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/learning\\-analytics(?:/)?$"
    },
    {
      "page": "/learning-workspace",
      "regex": "^/learning\\-workspace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/learning\\-workspace(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}